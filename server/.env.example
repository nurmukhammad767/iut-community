# =================================================================
# IUT Community — server/.env example
# Copy to `server/.env` and fill in real values before `docker compose up`.
# =================================================================

# --- Postgres (backend) ---
DB_USER=iut
DB_PASSWORD=change_me_strong
DB_NAME=iut
DB_HOST=backend-postgres
DB_PORT=5432

# --- MongoDB (timetable, chat persistence) ---
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=iut
MONGO_USER=
MONGO_PASSWORD=

# --- JWT / auth ---
SECRET_KEY=replace_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Airflow ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace_with_fernet_key
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./timetable_web_scraping
AIRFLOW__API_AUTH__JWT_SECRET=replace_with_random_secret
AIRFLOW__API_AUTH__JWT_ISSUER=airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- RabbitMQ / Celery (timetable reminders) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Compose / runtime ---
ENV_FILE_PATH=.env
AIRFLOW_IMAGE_NAME=apache/airflow:3.2.1
